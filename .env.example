# Everything is optional. With nothing set, WaveLoop runs fully in mock mode.

# Public URL used in referral links, QR codes and the Twilio signature check
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: local SQLite file by default; a Turso URL for hosted deploys
DATABASE_URL=file:waveloop.db
DATABASE_AUTH_TOKEN=

# Claude: AI project ideas, project grading, WhatsApp FAQ answers
ANTHROPIC_API_KEY=

# Email OTP (resend.com free tier)
RESEND_API_KEY=
EMAIL_FROM=WaveLoop <onboarding@resend.dev>

# Real WhatsApp bot + drip messages (Twilio WhatsApp sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Hashing salt for IP/device fingerprints and OTPs
APP_SECRET=change-me
# Lock /admin APIs (send as x-admin-key header or wl_admin cookie)
ADMIN_KEY=
# Protects /api/cron/drip (Vercel sends it automatically)
CRON_SECRET=
