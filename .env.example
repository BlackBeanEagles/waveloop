# Everything is optional. With nothing set, WaveLoop runs fully in mock mode.

# Public URL used in referral links, QR codes and the Twilio signature check
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: local SQLite file by default; a Turso URL for hosted deploys
DATABASE_URL=file:waveloop.db
DATABASE_AUTH_TOKEN=

# AI (ideas, copilot, grading, help desk). Pick ONE free option; leave the others out.
#   Gemini (free, best for Hindi/Telugu/Tamil): https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
#   Groq (free, very fast): https://console.groq.com/keys -> Create API Key (starts with gsk_). Default model openai/gpt-oss-120b; override with GROQ_MODEL
GROQ_API_KEY=
#   Optional: force one provider if you set several keys: gemini | groq | claude
# LLM_PROVIDER=gemini

# Paid alternative: Claude.
# Claude: AI project ideas, project grading, WhatsApp FAQ answers
ANTHROPIC_API_KEY=

# Email OTP (resend.com free tier)
RESEND_API_KEY=
EMAIL_FROM=WaveLoop <onboarding@resend.dev>

# Real WhatsApp bot, FREE: Meta WhatsApp Cloud API (official). Recommended over Twilio.
#   1. https://developers.facebook.com -> My Apps -> Create App -> type "Business" -> add the "WhatsApp" product.
#   2. WhatsApp -> API Setup: copy "Phone number ID". Add up to 5 test recipient numbers (yours + friends) and verify them.
#   3. Token: the temporary one on API Setup lasts 24h. For a lasting one: Business Settings -> System users ->
#      add one (Admin) -> Generate token for your app with whatsapp_business_messaging + whatsapp_business_management.
#   4. App Settings -> Basic -> App Secret -> Show -> copy.
#   5. After deploying: WhatsApp -> Configuration -> Webhook -> Callback URL https://<your-site>/api/whatsapp/meta,
#      Verify token = WHATSAPP_VERIFY_TOKEN below -> Verify and save -> Manage -> subscribe to "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=make-up-any-random-string

# Alternative (paid after trial): Real WhatsApp bot + drip messages (Twilio WhatsApp sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Hashing salt for IP/device fingerprints and OTPs
APP_SECRET=change-me
# Lock /admin APIs (send as x-admin-key header or wl_admin cookie)
ADMIN_KEY=
# Protects /api/cron/drip (Vercel sends it automatically)
CRON_SECRET=
